+// Small cache of open asset file descriptors: the game calls FS_LoadFile very often
+// (often for the same files), and opening/closing a file on the memory card is expensive.
+// sceIoPread() doesn't touch the file position, so a descriptor can be shared by threads.
+#define FS_ASSET_DIR "ux0:data/layton_future/assets/"
+#define FS_CACHE_SIZE 8
+
+typedef struct {
+	char name[192];
+	SceUID fd;
+	int users;
+	uint32_t stamp;
+	uint8_t used;
+} fs_cache_entry;
+
+static fs_cache_entry fs_cache[FS_CACHE_SIZE];
+static pthread_mutex_t fs_cache_mutex = PTHREAD_MUTEX_INITIALIZER;
+static uint32_t fs_cache_clock = 0;
+
+// Returns a file descriptor (or < 0 on error). *slot is the cache slot, or -1 if the
+// descriptor is not cached and must be closed by the caller.
+static SceUID fs_acquire(const char *full_fname, int *slot) {
+	*slot = -1;
+	if (strlen(full_fname) >= sizeof(fs_cache[0].name))
+		return sceIoOpen(full_fname, SCE_O_RDONLY, 0);
+
+	pthread_mutex_lock(&fs_cache_mutex);
+	int free_idx = -1, lru_idx = -1;
+	for (int i = 0; i < FS_CACHE_SIZE; i++) {
+		fs_cache_entry *e = &fs_cache[i];
+		if (e->used) {
+			if (!strcmp(e->name, full_fname)) {
+				e->users++;
+				e->stamp = ++fs_cache_clock;
+				SceUID fd = e->fd;
+				pthread_mutex_unlock(&fs_cache_mutex);
+				*slot = i;
+				return fd;
+			}
+			if (e->users == 0 && (lru_idx < 0 || e->stamp < fs_cache[lru_idx].stamp))
+				lru_idx = i;
+		} else if (free_idx < 0) {
+			free_idx = i;
+		}
+	}
+
+	SceUID fd = sceIoOpen(full_fname, SCE_O_RDONLY, 0);
+	if (fd < 0) {
+		pthread_mutex_unlock(&fs_cache_mutex);
+		return fd;
+	}
+
+	int idx = free_idx >= 0 ? free_idx : lru_idx;
+	if (idx < 0) { // Every slot is in use right now: just don't cache this one
+		pthread_mutex_unlock(&fs_cache_mutex);
+		return fd;
+	}
+
+	fs_cache_entry *e = &fs_cache[idx];
+	if (e->used)
+		sceIoClose(e->fd);
+	strcpy(e->name, full_fname);
+	e->fd = fd;
+	e->users = 1;
+	e->stamp = ++fs_cache_clock;
+	e->used = 1;
+	pthread_mutex_unlock(&fs_cache_mutex);
+	*slot = idx;
+	return fd;
+}
+
+static void fs_release(SceUID fd, int slot) {
+	if (slot < 0) {
+		sceIoClose(fd);
+		return;
+	}
+	pthread_mutex_lock(&fs_cache_mutex);
+	fs_cache[slot].users--;
+	pthread_mutex_unlock(&fs_cache_mutex);
+}
