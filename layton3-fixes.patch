+#ifdef FS_PROFILE
+	uint64_t t0 = sceKernelGetProcessTimeWide();
+#endif
+	int slot;
+	SceUID fd = fs_acquire(full_fname, &slot);
+	if (fd < 0)
+		return 0;
+	int done = 0;
+	while (done < size) {
+		int r = sceIoPread(fd, buf + done, size - done, (SceOff)pos + done);
