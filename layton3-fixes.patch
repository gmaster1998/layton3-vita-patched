+	fs_release(fd, slot);
+#ifdef FS_PROFILE
+	printf("FS_LoadFile %s: %d bytes in %llu us\n", fname, done, sceKernelGetProcessTimeWide() - t0);
+#endif
+	return 1;
 }
 
